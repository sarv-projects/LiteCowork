{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litecowork:schema:release-matrix-row:v1",
  "title": "LiteCowork Release Matrix Row v1 (accepted target interface, not yet in source)",
  "description": "Owner: Feature 019. One declared release tuple. A row that is not counted must carry a not_counted_reason; WSL2, container and CI image runs never count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "row_id", "os", "os_min_build", "arch", "target_triple", "desktop_runtime", "agent",
    "agent_version", "auth_mode", "protocol", "priority", "counted"
  ],
  "properties": {
    "row_id": {"type": "string", "pattern": "^(windows|linux)-x64-[a-z0-9-]+-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "os": {"type": "string", "enum": ["windows", "linux"]},
    "os_min_build": {"type": "string", "minLength": 1},
    "arch": {"type": "string", "enum": ["x86_64"]},
    "target_triple": {"type": "string", "enum": ["x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu"]},
    "desktop_runtime": {"type": "string", "enum": ["WebView2", "WebKitGTK"]},
    "agent": {"type": "string", "minLength": 1},
    "agent_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "auth_mode": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "minLength": 1},
    "priority": {"type": "integer", "enum": [1, 2]},
    "counted": {"type": "boolean"},
    "not_counted_reason": {"type": "string", "enum": ["WSL2", "CONTAINER", "CI_IMAGE", "UNSUPPORTED_HOST"]}
  },
  "allOf": [
    {
      "if": {"properties": {"counted": {"const": false}}, "required": ["counted"]},
      "then": {"required": ["not_counted_reason"]}
    },
    {
      "if": {"properties": {"counted": {"const": true}}, "required": ["counted"]},
      "then": {"not": {"required": ["not_counted_reason"]}}
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litecowork:schema:release-evidence-bundle:v1",
  "title": "LiteCowork Release Evidence Bundle v1 (accepted target interface, not yet in source)",
  "description": "Owner: Feature 019. Fields follow docs/ACCEPTANCE-AND-E2E-PLAN.md section 6. Never holds credentials, tokens, SecretLease bytes, private prompts or unredacted user content; attachments are referenced by SHA-256 digest only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journey_id", "requirement_ids", "owner_contracts", "row_id", "repo_sha", "dirty",
    "os_build", "arch", "packaging_mode", "agent_versions", "protocol", "code_commands",
    "system_trace", "user_artifacts", "negative_cases", "limitations", "reviewer", "accepted_at"
  ],
  "properties": {
    "journey_id": {"type": "string", "pattern": "^E2E-(0[1-9]|1[0-9]|2[0-9])$"},
    "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "owner_contracts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "row_id": {"type": "string", "pattern": "^(windows|linux)-x64-[a-z0-9-]+-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "repo_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirty": {"type": "boolean"},
    "os_build": {"type": "string", "minLength": 1},
    "arch": {"type": "string", "enum": ["x86_64"]},
    "packaging_mode": {"type": "string", "enum": ["packaged", "dev"]},
    "agent_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "protocol": {"type": "string", "minLength": 1},
    "code_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "output_digest"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "output_digest": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "system_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_ids", "correlation_ids", "event_sequences", "receipt_refs"],
      "properties": {
        "request_ids": {"type": "array", "items": {"type": "string"}},
        "correlation_ids": {"type": "array", "items": {"type": "string"}},
        "event_sequences": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "receipt_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "user_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "kind", "storage_ref"],
        "properties": {
          "digest": {"$ref": "#/$defs/sha256"},
          "kind": {"type": "string", "enum": ["screenshot", "video", "log", "walkthrough", "other"]},
          "storage_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "negative_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "outcome"],
        "properties": {
          "case": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["REJECTED", "REFUSED", "RECOVERED", "FAILED", "BLOCKED"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "reviewer": {"type": "string", "minLength": 1},
    "accepted_at": {"type": "string", "format": "date"},
    "user_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "date", "decision", "blocked_or_unknown"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "decision": {"type": "string", "enum": ["ACCEPT", "PARTIAL", "REJECT"]},
        "blocked_or_unknown": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
